# Names only. npm run setup generates the database values in .env.
POSTGRES_PORT=
POSTGRES_SUPERUSER_PASSWORD=
SW_APP_DB_PASSWORD=
SW_DATA_DB_PASSWORD=
# 32 random bytes, base64. Encrypts stored store credentials; losing it makes them unreadable.
SW_ENCRYPTION_KEY=
# Bearer token for the adapter and quarantine routes. If it's empty, they refuse every request.
INTERNAL_API_TOKEN=
# Optional. The HTTP server listens here. HOST defaults to 127.0.0.1 because internal routes have no auth.
PORT=
HOST=
# Optional, for a deploy behind a TLS proxy (PRD §21.3). What admin pages show customers.
# PUBLIC_BASE_URL is an origin such as https://app.example.com, and the only Origin admin forms accept.
# Setting PUBLIC_DB_HOST adds ?sslmode=require to connection strings. Unset, pages show localhost.
PUBLIC_BASE_URL=
PUBLIC_DB_HOST=
PUBLIC_DB_PORT=
# The first super admin, created at startup if none exists. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional. Limits the worker to one account's jobs.
WORKER_ACCOUNT_ID=
# Set this one yourself.
FIREWORKS_API_KEY=
# Optional. Defaults to the model in src/config.ts.
FIREWORKS_MODEL=
# Optional. Defaults to none, which turns reasoning off.
FIREWORKS_REASONING_EFFORT=
# Optional, for the demo's live tables panel: a postgres:// URL for sw_app on localhost. Also needs SW_ENCRYPTION_KEY.
DEMO_APP_DATABASE_URL=
