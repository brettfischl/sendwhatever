# Names only. npm run setup generates the database values in .env.
POSTGRES_PORT=
POSTGRES_SUPERUSER_PASSWORD=
SW_APP_DB_PASSWORD=
SW_DATA_DB_PASSWORD=
# 32 random bytes, base64. Encrypts stored store credentials; losing it makes them unreadable.
SW_ENCRYPTION_KEY=
# Bearer token for the adapter and quarantine routes. If it's empty, they refuse every request.
INTERNAL_API_TOKEN=
# Optional. The HTTP server listens here. HOST defaults to 127.0.0.1 because internal routes have no auth.
PORT=
HOST=
# The first super admin, created at startup if none exists. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set this one yourself.
FIREWORKS_API_KEY=
# Optional. Defaults to the model in src/config.ts.
FIREWORKS_MODEL=
